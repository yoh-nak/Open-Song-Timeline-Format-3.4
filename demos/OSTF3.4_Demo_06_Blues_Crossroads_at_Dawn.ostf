  "lyrics": {
    "documents": [
      {
        "id": "lyrics-main",
        "title": "Lyrics",
        "language": "en"
      }
    ],
    "phrases": [
      {
        "id": "phrase-1",
        "documentId": "lyrics-main",
        "text": "Rain at the crossroads",
        "pronunciation": "rain at the cross roads",
        "start": 15360,
        "duration": 7680
      },
      {
        "id": "phrase-2",
        "documentId": "lyrics-main",
        "text": "Waiting here for you",
        "pronunciation": "Wait ing here for you",
        "start": 23040,
        "duration": 7680
      },
      {
        "id": "phrase-3",
        "documentId": "lyrics-main",
        "text": "My old guitar is crying",
        "pronunciation": "My old gui tar is cry ing",
        "start": 30720,
        "duration": 7680
      },
      {
        "id": "phrase-4",
        "documentId": "lyrics-main",
        "text": "And the morning rain is blue",
        "pronunciation": "And the morn ing rain is blue",
        "start": 38400,
        "duration": 7680
      },
      {
        "id": "phrase-5",
        "documentId": "lyrics-main",
        "text": "The sun is slowly rising",
        "pronunciation": "The sun is slow ly ris ing",
        "start": 46080,
        "duration": 7680
      },
      {
        "id": "phrase-6",
        "documentId": "lyrics-main",
        "text": "But my heart is missing you",
        "pronunciation": "But my heart is miss ing you",
        "start": 53760,
        "duration": 7680
      },
      {
        "id": "phrase-7",
        "documentId": "lyrics-main",
        "text": "Dust on my old shoes",
        "pronunciation": "Dust on my old shoes",
        "start": 61440,
        "duration": 7680
      },
      {
        "id": "phrase-8",
        "documentId": "lyrics-main",
        "text": "No sign of you yet",
        "pronunciation": "No sign of you yet",
        "start": 69120,
        "duration": 7680
      },
      {
        "id": "phrase-9",
        "documentId": "lyrics-main",
        "text": "The rusty bridge is shaking",
        "pronunciation": "The rust y bridge is shak ing",
        "start": 76800,
        "duration": 7680
      },
      {
        "id": "phrase-10",
        "documentId": "lyrics-main",
        "text": "I can hear the river cry",
        "pronunciation": "I can hear the riv er cry",
        "start": 84480,
        "duration": 7680
      },
      {
        "id": "phrase-11",
        "documentId": "lyrics-main",
        "text": "The sky is turning scarlet",
        "pronunciation": "The sky is turn ing scar let",
        "start": 92160,
        "duration": 7680
      },
      {
        "id": "phrase-12",
        "documentId": "lyrics-main",
        "text": "And I am still here for you",
        "pronunciation": "And I am still here for you",
        "start": 99840,
        "duration": 7680
      },
      {
        "id": "phrase-13",
        "documentId": "lyrics-main",
        "text": "Sun on the highway",
        "pronunciation": "Sun on the high way",
        "start": 199680,
        "duration": 7680
      },
      {
        "id": "phrase-14",
        "documentId": "lyrics-main",
        "text": "Nothing left to prove",
        "pronunciation": "Noth ing left to prove",
        "start": 207360,
        "duration": 7680
      },
      {
        "id": "phrase-15",
        "documentId": "lyrics-main",
        "text": "My six strings keep on ringing",
        "pronunciation": "My six strings keep on ring ing",
        "start": 215040,
        "duration": 7680
      },
      {
        "id": "phrase-16",
        "documentId": "lyrics-main",
        "text": "As the early light turns gold",
        "pronunciation": "As the ear ly light turns gold",
        "start": 222720,
        "duration": 7680
      },
      {
        "id": "phrase-17",
        "documentId": "lyrics-main",
        "text": "The road is opening wide",
        "pronunciation": "The road is o pen ing wide",
        "start": 230400,
        "duration": 7680
      },
      {
        "id": "phrase-18",
        "documentId": "lyrics-main",
        "text": "I leave the past behind me",
        "pronunciation": "I leave the past be hind me",
        "start": 238080,
        "duration": 7680
      }
    ],
