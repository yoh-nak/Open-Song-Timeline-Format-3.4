    "phrases": [
      {
        "id": "phrase-1",
        "documentId": "lyrics-main",
        "text": "We kick the doors wide open",
        "pronunciation": "We kick the doors wide open",
        "start": 30720,
        "duration": 7680
      },
      {
        "id": "phrase-2",
        "documentId": "lyrics-main",
        "text": "The storm is in our way",
        "pronunciation": "The storm is in our way",
        "start": 38400,
        "duration": 7680
      },
      {
        "id": "phrase-3",
        "documentId": "lyrics-main",
        "text": "A spark beneath the ashes",
        "pronunciation": "A spark be neath the ash es",
        "start": 46080,
        "duration": 7680
      },
      {
        "id": "phrase-4",
        "documentId": "lyrics-main",
        "text": "Will carry us today",
        "pronunciation": "Will car ry us to day",
        "start": 53760,
        "duration": 7680
      },
      {
        "id": "phrase-5",
        "documentId": "lyrics-main",
        "text": "Raise your voice tonight",
        "pronunciation": "Raise your voice to night",
        "start": 61440,
        "duration": 7680
      },
      {
        "id": "phrase-6",
        "documentId": "lyrics-main",
        "text": "Hold the line with me",
        "pronunciation": "Hold the line with me",
        "start": 69120,
        "duration": 7680
      },
      {
        "id": "phrase-7",
        "documentId": "lyrics-main",
        "text": "We will break the silence",
        "pronunciation": "We will break the si lence",
        "start": 76800,
        "duration": 7680
      },
      {
        "id": "phrase-8",
        "documentId": "lyrics-main",
        "text": "We will set it free",
        "pronunciation": "We will set it free",
        "start": 84480,
        "duration": 7680
      },
      {
        "id": "phrase-9",
        "documentId": "lyrics-main",
        "text": "Our hearts beat like drums",
        "pronunciation": "Our hearts beat like drums",
        "start": 92160,
        "duration": 7680
      },
      {
        "id": "phrase-10",
        "documentId": "lyrics-main",
        "text": "The ground starts to shake",
        "pronunciation": "The ground starts to shake",
        "start": 99840,
        "duration": 7680
      },
      {
        "id": "phrase-11",
        "documentId": "lyrics-main",
        "text": "We hear a rising crowd",
        "pronunciation": "We hear a ris ing crowd",
        "start": 107520,
        "duration": 7680
      },
      {
        "id": "phrase-12",
        "documentId": "lyrics-main",
        "text": "We will not turn back",
        "pronunciation": "We will not turn back",
        "start": 115200,
        "duration": 7680
      },
      {
