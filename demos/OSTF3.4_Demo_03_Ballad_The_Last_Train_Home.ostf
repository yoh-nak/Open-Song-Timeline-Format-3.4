    "phrases": [
      {
        "id": "phrase-1",
        "documentId": "lyrics-main",
        "text": "Your letter on the table",
        "pronunciation": "Your let ter on the ta ble",
        "start": 15360,
        "duration": 7680
      },
      {
        "id": "phrase-2",
        "documentId": "lyrics-main",
        "text": "The last train rolling home",
        "pronunciation": "The last train rolling home",
        "start": 23040,
        "duration": 7680
      },
      {
        "id": "phrase-3",
        "documentId": "lyrics-main",
        "text": "I hear the rain beside me",
        "pronunciation": "I hear the rain be side me",
        "start": 30720,
        "duration": 7680
      },
      {
        "id": "phrase-4",
        "documentId": "lyrics-main",
        "text": "And wish you were not gone",
        "pronunciation": "And wish you were not gone",
        "start": 38400,
        "duration": 7680
      },
      {
        "id": "phrase-5",
        "documentId": "lyrics-main",
        "text": "Stay with me tonight",
        "pronunciation": "Stay with me to night",
        "start": 46080,
        "duration": 7680
      },
      {
        "id": "phrase-6",
        "documentId": "lyrics-main",
        "text": "Hold me one more time",
        "pronunciation": "Hold me one more time",
        "start": 53760,
        "duration": 7680
      },
      {
        "id": "phrase-7",
        "documentId": "lyrics-main",
        "text": "Your voice is in the silence",
        "pronunciation": "Your voice is in the si lence",
        "start": 61440,
        "duration": 7680
      },
      {
        "id": "phrase-8",
        "documentId": "lyrics-main",
        "text": "Your hand belongs in mine",
        "pronunciation": "Your hand be longs in mine",
        "start": 69120,
        "duration": 7680
      },
      {
        "id": "phrase-9",
        "documentId": "lyrics-main",
        "text": "I trace the fogged up window",
        "pronunciation": "I trace the fogged up win dow",
        "start": 76800,
        "duration": 7680
      },
      {
        "id": "phrase-10",
        "documentId": "lyrics-main",
        "text": "And watch the towns slip by",
        "pronunciation": "And watch the towns slip by",
        "start": 84480,
        "duration": 7680
      },
      {
        "id": "phrase-11",
        "documentId": "lyrics-main",
        "text": "I keep your last note",
        "pronunciation": "I keep your last note",
        "start": 92160,
        "duration": 7680
      },
      {
        "id": "phrase-12",
        "documentId": "lyrics-main",
        "text": "The stations fall back",
        "pronunciation": "The sta tions fall back",
        "start": 99840,
        "duration": 7680
      },
      {
        "id": "phrase-13",
        "documentId": "lyrics-main",
        "text": "The miles turn to years",
        "pronunciation": "The miles turn to years",
        "start": 107520,
        "duration": 7680
      },
      {
        "id": "phrase-14",
        "documentId": "lyrics-main",
        "text": "I still know your smile",
        "pronunciation": "I still know your smile",
        "start": 115200,
        "duration": 7680
      },
      {
        "id": "phrase-15",
        "documentId": "lyrics-main",
        "text": "Your name beneath the silence",
