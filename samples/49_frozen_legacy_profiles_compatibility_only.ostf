        "sourceText": "{\n  \"format\": \"OSTF\",\n  \"version\": \"2.3.0\",\n  \"ppq\": 960,\n  \"song\": {\n    \"title\": \"Composite song with roles colors chords melody lyrics\"\n  },\n  \"timeline\": {\n    \"sections\": [\n      {\n        \"id\": \"s1\",\n        \"name\": \"Intro\",\n        \"start\": 0,\n        \"duration\": 15360,\n        \"role\": \"intro\"\n      },\n      {\n        \"id\": \"s2\",\n        \"name\": \"Verse\",\n        \"start\": 15360,\n        \"duration\": 15360,\n        \"role\": \"other\"\n      },\n      {\n        \"id\": \"s3\",\n        \"name\": \"Chorus\",\n        \"start\": 30720,\n        \"duration\": 15360,\n        \"role\": \"other\"\n      }\n    ],\n    \"tempoChanges\": [\n      {\n        \"at\": 0,\n        \"bpm\": 120\n      }\n    ],\n    \"meterChanges\": [\n      {\n        \"at\": 0,\n        \"numerator\": 4,\n        \"denominator\": 4\n      }\n    ]\n  },\n  \"harmony\": {\n    \"chords\": [\n      {\n        \"id\": \"chord1\",\n        \"start\": 0,\n        \"duration\": 1920,\n        \"symbol\": \"Am7\"\n      },\n      {\n        \"id\": \"chord2\",\n        \"start\": 1920,\n        \"duration\": 1920,\n        \"symbol\": \"D7\"\n      },\n      {\n        \"id\": \"chord3\",\n        \"start\": 3840,\n        \"duration\": 1920,\n        \"symbol\": \"Gmaj7\"\n      },\n      {\n        \"id\": \"chord4\",\n        \"start\": 5760,\n        \"duration\": 1920,\n        \"symbol\": \"Cmaj7\"\n      }\n    ]\n  },\n  \"melodies\": [\n    {\n      \"id\": \"lead\",\n      \"name\": \"Lead\",\n      \"clips\": [\n        {\n          \"id\": \"melody1\",\n          \"start\": 0,\n          \"duration\": 1920,\n          \"notes\": [\n            {\n              \"pitch\": 60,\n              \"start\": 0,\n              \"duration\": 480\n            }\n          ]\n        },\n        {\n          \"id\": \"melody2\",\n          \"start\": 1920,\n          \"duration\": 1920,\n          \"not